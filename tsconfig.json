{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "strict": true,
      "esModuleInterop": true,
      "rootDir": ".",
      "outDir": "dist",
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "types": ["node"]
    },
    "include": [
      "src/**/*.ts",
      "src/types/*.d.ts",
      "tests/**/*.ts"
    ]
  }
  